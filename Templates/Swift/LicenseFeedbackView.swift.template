import SwiftUI

/// Opt-in, user-initiated feature-request sheet — generated only when the
/// integration chose the endpoint feedback mode (`--feedback-endpoint`).
///
/// This file contains the ONLY network call in the generated licensing code.
/// It fires exactly once per explicit press of Send and transmits only what
/// is visible in this view: the message, the optional email, the app's short
/// version, and the current tier (free/pro/trial). Nothing is sent in the
/// background, nothing retries silently, and no identifiers are collected.
/// Never add telemetry, analytics, or additional networking here or to any
/// other generated file.
struct LicenseFeedbackView: View {
    @ObservedObject var license: LicenseManager
    @Environment(\.dismiss) private var dismiss
    @State private var message = ""
    @State private var email = ""
    @State private var sending = false
    @State private var sent = false
    @State private var errorText: String?

    /// One radius for every control on the sheet.
    private let cornerRadius: CGFloat = 12

    var body: some View {
        VStack(spacing: 0) {
            ZStack {
                Capsule()
                    .fill(Color.secondary.opacity(0.25))
                    .frame(width: 40, height: 5)
                    .padding(.top, 10)
                HStack {
                    Spacer()
                    Button { dismiss() } label: {
                        Image(systemName: "xmark")
                            .font(.system(size: 12, weight: .semibold))
                            .foregroundStyle(.secondary)
                            .frame(width: 28, height: 28)
                            .background(Circle().fill(Color.primary.opacity(0.05)))
                    }
                    .buttonStyle(.plain)
                    .padding(.top, 12)
                    .padding(.trailing, 14)
                }
            }

            if sent {
                sentContent
            } else {
                formContent
            }
        }
        .frame(width: 460)
    }

    private var sentContent: some View {
        VStack(spacing: 8) {
            iconBadge("checkmark")

            Text("Request Sent")
                .font(.system(size: 26, weight: .bold))

            Text("Thanks — it went straight to the developer\nand shapes what gets built next.")
                .font(.system(size: 14))
                .foregroundStyle(.secondary)
                .multilineTextAlignment(.center)
                .fixedSize(horizontal: false, vertical: true)

            Button { dismiss() } label: {
                Text("Done")
                    .font(.system(size: 15, weight: .semibold))
                    .foregroundStyle(.white)
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 13)
                    .background(RoundedRectangle(cornerRadius: cornerRadius)
                        .fill(Color.accentColor))
            }
            .buttonStyle(.plain)
            .keyboardShortcut(.defaultAction)
            .padding(.top, 16)
        }
        .padding(.horizontal, 24)
        .padding(.top, 18)
        .padding(.bottom, 24)
    }

    private var formContent: some View {
        VStack(spacing: 0) {
            VStack(spacing: 8) {
                iconBadge("bubble.left")

                Text("Request a Feature")
                    .font(.system(size: 26, weight: .bold))

                Text("What should this app do next?\nYour message goes directly to the developer.")
                    .font(.system(size: 14))
                    .foregroundStyle(.secondary)
                    .multilineTextAlignment(.center)
                    .fixedSize(horizontal: false, vertical: true)
            }
            .padding(.top, 18)

            VStack(spacing: 14) {
                ZStack(alignment: .topLeading) {
                    TextEditor(text: $message)
                        .font(.system(size: 14))
                        .scrollContentBackground(.hidden)
                        .padding(.horizontal, 9)
                        .padding(.vertical, 9)
                    if message.isEmpty {
                        Text("Tell us your idea…")
                            .font(.system(size: 14))
                            .foregroundStyle(Color(nsColor: .placeholderTextColor))
                            .padding(.horizontal, 14)
                            .padding(.vertical, 13)
                            .allowsHitTesting(false)
                    }
                }
                .frame(minHeight: 170)
                .background(fieldShape)

                TextField("Email (optional — for follow-up questions)", text: $email)
                    .textFieldStyle(.plain)
                    .font(.system(size: 14))
                    .padding(.horizontal, 14)
                    .padding(.vertical, 13)
                    .background(fieldShape)

                if let errorText {
                    Text(errorText)
                        .font(.callout)
                        .foregroundStyle(.red)
                        .fixedSize(horizontal: false, vertical: true)
                }

                HStack(spacing: 12) {
                    Spacer()
                    Button { dismiss() } label: {
                        Text("Cancel")
                            .font(.system(size: 15, weight: .medium))
                            .padding(.horizontal, 24)
                            .padding(.vertical, 12)
                            .background(RoundedRectangle(cornerRadius: cornerRadius)
                                .fill(Color.primary.opacity(0.06)))
                    }
                    .buttonStyle(.plain)
                    .keyboardShortcut(.cancelAction)

                    Button { Task { await send() } } label: {
                        Text(sending ? "Sending…" : "Send")
                            .font(.system(size: 15, weight: .semibold))
                            .foregroundStyle(messageIsEmpty ? Color.secondary : Color.white)
                            .padding(.horizontal, 28)
                            .padding(.vertical, 12)
                            .background(RoundedRectangle(cornerRadius: cornerRadius)
                                .fill(messageIsEmpty ? Color.primary.opacity(0.06) : Color.accentColor))
                    }
                    .buttonStyle(.plain)
                    .keyboardShortcut(.defaultAction)
                    .disabled(sending || messageIsEmpty)
                }
            }
            .padding(.horizontal, 24)
            .padding(.top, 22)
            .padding(.bottom, 24)
        }
    }

    private var messageIsEmpty: Bool {
        message.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
    }

    private func iconBadge(_ systemImage: String) -> some View {
        RoundedRectangle(cornerRadius: 16)
            .fill(Color.accentColor)
            .frame(width: 64, height: 64)
            .overlay(
                Image(systemName: systemImage)
                    .font(.system(size: 28, weight: .semibold))
                    .foregroundStyle(.white))
            .shadow(color: Color.accentColor.opacity(0.3), radius: 10, y: 4)
            .padding(.bottom, 10)
    }

    private var fieldShape: some View {
        RoundedRectangle(cornerRadius: cornerRadius)
            .fill(Color(nsColor: .textBackgroundColor))
            .overlay(RoundedRectangle(cornerRadius: cornerRadius)
                .strokeBorder(Color(nsColor: .separatorColor)))
    }

    private var tier: String {
        switch license.state {
        case .licensed: return "pro"
        case .trial: return "trial"
        default: return "free"
        }
    }

    /// The single, user-initiated network request. Called exclusively from the
    /// Send button above; never call it from anywhere else.
    private func send() async {
        guard let endpoint = LicenseConfig.feedbackEndpoint else { return }
        sending = true
        defer { sending = false }
        errorText = nil

        let version = Bundle.main.object(
            forInfoDictionaryKey: "CFBundleShortVersionString") as? String ?? ""
        let payload: [String: String] = [
            "mode": tier,
            "version": version,
            "message": message.trimmingCharacters(in: .whitespacesAndNewlines),
            "email": email.trimmingCharacters(in: .whitespacesAndNewlines),
        ]

        var request = URLRequest(url: endpoint)
        request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        request.httpBody = try? JSONSerialization.data(withJSONObject: payload)

        do {
            let (_, response) = try await URLSession.shared.data(for: request)
            guard let http = response as? HTTPURLResponse, (200...299).contains(http.statusCode) else {
                errorText = "Could not send your request right now. Please try again later."
                return
            }
            sent = true
        } catch {
            errorText = "You appear to be offline. Your request was not sent."
        }
    }
}
