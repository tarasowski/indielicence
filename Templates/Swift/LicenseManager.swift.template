import Combine
import Foundation

/// App-facing state derived from full offline validation.
enum AppLicenseState: Equatable {
    case unlicensed
    /// Freemium distribution only: no stored key, and that is a fully valid
    /// state — the free core never expires and never locks.
    case free
    case trial(daysRemaining: Int, expiresOn: Date)
    case trialExpired(on: Date)
    case licensed(LicenseInfo)
    case renewalRequired(until: Date)
    case invalid(LicenseInvalidReason)
    case storageFailure
}

/// Small app-owned coordinator around the standalone IndieLicense verifier.
/// Keep UI, pricing, checkout, and feature policy outside this type.
@MainActor
final class LicenseManager: ObservableObject {
    @Published private(set) var state: AppLicenseState = .unlicensed

#if DEBUG && !INDIELICENSE_DISABLE_DEVELOPMENT_HARNESS
    @Published private(set) var developmentScenario: IndieLicenseDevelopmentScenario
#endif

    var isLicensed: Bool {
        if case .licensed = state { return true }
        return false
    }

    /// True when a purchased key unlocks the Pro tier. In freemium builds gate
    /// Pro features with this; the free core needs no license checks at all.
    var isPro: Bool { isLicensed }

    /// True while the customer may use paid features: licensed, or inside the
    /// keyless trial window when `LicenseConfig.trialDays` is set.
    var hasFullAccess: Bool {
        switch state {
        case .licensed, .trial: return true
        default: return false
        }
    }

    init() {
#if DEBUG && !INDIELICENSE_DISABLE_DEVELOPMENT_HARNESS
        developmentScenario = IndieLicenseDevelopmentScenario.requested() ?? .fullAccess
#endif
        refresh()
#if DEBUG && !INDIELICENSE_DISABLE_DEVELOPMENT_HARNESS
        IndieLicenseDevelopmentMenu.shared.install(for: self)
#endif
    }

    /// Revalidates the stored key. Call after replacing bundled denylist data.
    func refresh() {
#if DEBUG && !INDIELICENSE_DISABLE_DEVELOPMENT_HARNESS
        if let developmentState = developmentScenario.state() {
            state = developmentState
            return
        }
#endif
        do {
            guard let key = try LicenseStore.shared.load(), !key.isEmpty else {
                state = LicenseConfig.freemium ? .free : keylessTrialState()
                return
            }
            apply(LicenseConfig.makeValidator().validate(key))
        } catch {
            state = .storageFailure
        }
    }

#if DEBUG && !INDIELICENSE_DISABLE_DEVELOPMENT_HARNESS
    /// Switches state in memory without touching the persisted license or
    /// keyless-trial anchor. Available only in Debug builds.
    func setDevelopmentScenario(_ scenario: IndieLicenseDevelopmentScenario) {
        developmentScenario = scenario
        refresh()
        IndieLicenseDevelopmentMenu.shared.updateSelection()
    }
#endif

    /// Validates and securely persists a pasted key.
    @discardableResult
    func activate(key: String) -> Bool {
        let key = key.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !key.isEmpty else {
            state = .invalid(.malformed("empty key"))
            return false
        }

#if DEBUG && !INDIELICENSE_DISABLE_DEVELOPMENT_HARNESS
        // Simulated states must never persist a real or fake key. Treat a
        // non-empty entry as a successful simulated activation instead.
        if developmentScenario != .real {
            setDevelopmentScenario(.fullAccess)
            return true
        }
#endif

        let result = LicenseConfig.makeValidator().validate(key)
        guard case .valid(let info) = result else {
            apply(result)
            return false
        }

        do {
            try LicenseStore.shared.save(key: key)
            state = .licensed(info)
            return true
        } catch {
            state = .storageFailure
            return false
        }
    }

    /// State for a customer with no stored key. When `LicenseConfig.trialDays`
    /// is set, the first call stamps the trial start day once in the file store
    /// (reusing the verifier's stamp-once activation anchoring) and the window
    /// is inclusive of its final day, matching trial-key semantics.
    private func keylessTrialState() -> AppLicenseState {
        guard let trialDays = LicenseConfig.trialDays, trialDays > 0 else {
            return .unlicensed
        }
        do {
            let startedAt = try LicenseStore.shared.activatedAt(
                for: "keyless-trial:\(LicenseConfig.product)")
            let expiresDay = unixDay(of: startedAt) + trialDays
            let today = unixDay(of: Date())
            guard today <= expiresDay else {
                return .trialExpired(on: date(ofUnixDay: expiresDay))
            }
            return .trial(
                daysRemaining: expiresDay - today,
                expiresOn: date(ofUnixDay: expiresDay))
        } catch {
            return .storageFailure
        }
    }

    /// Link for the "Request a feature" button, or nil when no feedback
    /// destination is configured. A web destination gets the current tier
    /// (free/pro/trial) and the app's short version appended as query items;
    /// a mailto destination gets them pre-filled in the subject instead. The
    /// link must only ever be handed to the system (browser or mail client) —
    /// the app itself never performs a network request.
    func feedbackLink() -> URL? {
        guard let base = LicenseConfig.feedbackURL,
              var components = URLComponents(url: base, resolvingAgainstBaseURL: false) else {
            return nil
        }
        let version = Bundle.main.object(
            forInfoDictionaryKey: "CFBundleShortVersionString") as? String ?? ""
        let tier: String
        switch state {
        case .licensed: tier = "pro"
        case .trial: tier = "trial"
        default: tier = "free"
        }
        if components.scheme == "mailto" {
            let subject = "Feature request — \(LicenseConfig.product)"
                + (version.isEmpty ? "" : " \(version)") + " (\(tier))"
            components.queryItems = (components.queryItems ?? []) + [
                URLQueryItem(name: "subject", value: subject),
            ]
        } else {
            components.queryItems = (components.queryItems ?? []) + [
                URLQueryItem(name: "mode", value: tier),
                URLQueryItem(name: "version", value: version),
            ]
        }
        return components.url
    }

    private func apply(_ result: LicenseValidationResult) {
        switch result {
        case .valid(let info):
            state = .licensed(info)
        case .invalid(.updatesExpired(let until)):
            state = .renewalRequired(until: until)
        case .invalid(.storageFailure):
            state = .storageFailure
        case .invalid(let reason):
            state = .invalid(reason)
        }
    }
}

private func unixDay(of date: Date) -> Int {
    Int(floor(date.timeIntervalSince1970 / 86_400))
}

private func date(ofUnixDay day: Int) -> Date {
    Date(timeIntervalSince1970: Double(day) * 86_400)
}
