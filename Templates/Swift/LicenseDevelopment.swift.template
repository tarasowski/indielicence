#if DEBUG && !INDIELICENSE_DISABLE_DEVELOPMENT_HARNESS
import AppKit
import Foundation

/// In-memory license states for development and UI automation. This entire
/// file is omitted by the Swift compiler unless `DEBUG` is defined.
///
/// The cases are deterministic *presets*: each one pins the complete
/// simulated world — the license state, fixed days-left numbers, and (for
/// freemium presets) whether the Pro tier is on sale. `relevantCases`
/// derives the menu from `LicenseConfig`, so every app's menu lists exactly
/// the situations that can occur for its distribution model and nothing
/// impossible is representable.
enum IndieLicenseDevelopmentScenario: String, CaseIterable, Identifiable {
    // Freemium presets (distribution = freemium).
    case freemiumFree = "freemium-free"
    case freemiumFreeKeyActive = "freemium-free-key-active"
    case freemiumProNotActive = "freemium-pro-not-active"
    case freemiumProLifetime = "freemium-pro-lifetime"
    case freemiumProUpdates = "freemium-pro-updates"
    case freemiumProUpdatesExpireSoon = "freemium-pro-updates-expire-soon"
    case freemiumProUpdatesLapsed = "freemium-pro-updates-lapsed"
    case freemiumProTrial = "freemium-pro-trial"
    case freemiumProTrialLastDay = "freemium-pro-trial-last-day"
    case freemiumProTrialExpired = "freemium-pro-trial-expired"
    // Paid presets (distribution = paid).
    case fullAccess = "full-access"
    case licensedUpdates = "licensed-updates"
    case licensedUpdatesExpireSoon = "licensed-updates-expire-soon"
    case renewalRequired = "renewal-required"
    case trial = "trial"
    case trialEndingToday = "trial-ending-today"
    case trialExpired = "trial-expired"
    case unlicensed = "unlicensed"
    case licensedTrialKey = "trial-key"
    case trialKeyExpired = "trial-key-expired"
    // Shared problem states and reality.
    case invalidLicense = "invalid-license"
    case keyRevoked = "key-revoked"
    case storageFailure = "storage-failure"
    case real = "real"

    static let environmentKey = "INDIELICENSE_TEST_STATE"

    var id: String { rawValue }

    /// Pinned simulation numbers, mirroring the app's configuration where one
    /// exists so menu names match reality: the keyless trial length (7 when
    /// none is configured), the trial-key length (documented 14-day default),
    /// the common one-year update window, and the expiring-soon warning
    /// window. Fixed values, never wall-clock drift — screenshots and UI
    /// tests reproduce.
    static var simulatedTrialDays: Int { LicenseConfig.trialDays ?? 7 }
    static var simulatedTrialKeyDays: Int { LicenseConfig.trialDays ?? 14 }
    static let simulatedUpdatesDays = 365
    static let simulatedExpireSoonDays = 7

    /// The presets that can actually occur for this app, in menu order,
    /// derived from `LicenseConfig`: freemium apps get the freemium presets,
    /// paid apps with a keyless trial get the trial presets, paid apps
    /// without one get "Not Purchased" instead. Problem states and the real
    /// persisted state apply everywhere. Cases outside this list remain
    /// selectable via launch arguments for cross-model UI tests.
    static var relevantCases: [Self] {
        var cases: [Self]
        if LicenseConfig.freemium {
            cases = [.freemiumFree, .freemiumFreeKeyActive, .freemiumProNotActive,
                     .freemiumProLifetime, .freemiumProUpdates,
                     .freemiumProUpdatesExpireSoon, .freemiumProUpdatesLapsed,
                     .freemiumProTrial, .freemiumProTrialLastDay,
                     .freemiumProTrialExpired]
        } else if LicenseConfig.trialDays != nil {
            cases = [.trial, .trialEndingToday, .trialExpired,
                     .fullAccess, .licensedUpdates, .licensedUpdatesExpireSoon,
                     .renewalRequired, .licensedTrialKey, .trialKeyExpired]
        } else {
            cases = [.unlicensed,
                     .fullAccess, .licensedUpdates, .licensedUpdatesExpireSoon,
                     .renewalRequired, .licensedTrialKey, .trialKeyExpired]
        }
        cases += [.invalidLicense, .keyRevoked, .storageFailure, .real]
        return cases
    }

    /// Freemium presets simulate the product phase too: whether the Pro tier
    /// is on sale. nil = not simulated (paid presets, or the real scenario) —
    /// the app should fall back to its own shipped-features flag.
    var simulatesProOnSale: Bool? {
        switch self {
        case .freemiumFree, .freemiumFreeKeyActive:
            return false
        case .freemiumProNotActive, .freemiumProLifetime, .freemiumProUpdates,
             .freemiumProUpdatesExpireSoon, .freemiumProUpdatesLapsed,
             .freemiumProTrial, .freemiumProTrialLastDay, .freemiumProTrialExpired:
            return true
        default:
            return nil
        }
    }

    var title: String {
        let trialKeyDays = Self.simulatedTrialKeyDays
        let trialKeySuffix = "\(trialKeyDays) Day\(trialKeyDays == 1 ? "" : "s") Left"
        switch self {
        case .freemiumFree:
            return "Freemium — No Pro"
        case .freemiumFreeKeyActive:
            return "Freemium — No Pro, Key Active"
        case .freemiumProNotActive:
            return "Freemium — Pro Not Active"
        case .freemiumProLifetime:
            return "Freemium — Pro Active (Lifetime)"
        case .freemiumProUpdates:
            return "Freemium — Pro Active (1 Year of Updates)"
        case .freemiumProUpdatesExpireSoon:
            return "Freemium — Pro Updates Expire in \(Self.simulatedExpireSoonDays) Days"
        case .freemiumProUpdatesLapsed:
            return "Freemium — Pro, Updates Lapsed"
        case .freemiumProTrial:
            return "Freemium — Pro Trial, \(trialKeySuffix)"
        case .freemiumProTrialLastDay:
            return "Freemium — Pro Trial, Last Day"
        case .freemiumProTrialExpired:
            return "Freemium — Pro Trial Expired"
        case .fullAccess:
            return "Licensed — Lifetime Key"
        case .licensedUpdates:
            return "Licensed — 1 Year of Updates"
        case .licensedUpdatesExpireSoon:
            return "Licensed — Updates Expire in \(Self.simulatedExpireSoonDays) Days"
        case .renewalRequired:
            return "Licensed — Updates Lapsed"
        case .trial:
            return "Trial — \(Self.simulatedTrialDays) Day\(Self.simulatedTrialDays == 1 ? "" : "s") Left"
        case .trialEndingToday:
            return "Trial — Last Day"
        case .trialExpired:
            return LicenseConfig.hardGate ? "Trial Expired — Locked" : "Trial Expired — Limited"
        case .unlicensed:
            return LicenseConfig.hardGate ? "Not Purchased — Locked" : "Not Purchased — Limited"
        case .licensedTrialKey:
            return "Vendor Trial Key — \(trialKeySuffix)"
        case .trialKeyExpired:
            return "Vendor Trial Key — Expired"
        case .invalidLicense:
            return "Key Problem — Invalid"
        case .keyRevoked:
            return "Key Problem — Revoked"
        case .storageFailure:
            return "Key Problem — Storage Unavailable"
        case .real:
            return "Real Persisted State"
        }
    }

    static func requested(
        arguments: [String] = ProcessInfo.processInfo.arguments,
        environment: [String: String] = ProcessInfo.processInfo.environment
    ) -> Self? {
        if let argument = arguments.first(where: { $0.hasPrefix("--indielicense-state=") }),
           let value = argument.split(separator: "=", maxSplits: 1).last,
           let scenario = Self(rawValue: String(value)) {
            return scenario
        }

        if let index = arguments.firstIndex(of: "--indielicense-state"),
           arguments.indices.contains(index + 1),
           let scenario = Self(rawValue: arguments[index + 1]) {
            return scenario
        }

        return environment[environmentKey].flatMap(Self.init(rawValue:))
    }

    func state(now: Date = Date()) -> AppLicenseState? {
        let today = indieLicenseDevelopmentDate(
            ofUnixDay: indieLicenseDevelopmentUnixDay(of: now))

        func lifetimeKey() -> AppLicenseState {
            .licensed(LicenseInfo(
                product: LicenseConfig.product,
                keyID: 0,
                issuedAt: today,
                expiresDurationDays: nil,
                updatesDurationDays: nil,
                isLifetime: true,
                effectiveExpiresAt: nil,
                effectiveUpdatesUntil: nil,
                denylistSequence: nil))
        }
        func updatesKey(untilDays: Int) -> AppLicenseState {
            .licensed(LicenseInfo(
                product: LicenseConfig.product,
                keyID: 0,
                issuedAt: today,
                expiresDurationDays: nil,
                updatesDurationDays: UInt16(clamping: Self.simulatedUpdatesDays),
                isLifetime: false,
                effectiveExpiresAt: nil,
                effectiveUpdatesUntil: today.addingTimeInterval(Double(untilDays) * 86_400),
                denylistSequence: nil))
        }
        func expiringKey(daysLeft: Int) -> AppLicenseState {
            .licensed(LicenseInfo(
                product: LicenseConfig.product,
                keyID: 0,
                issuedAt: today,
                expiresDurationDays: UInt16(clamping: max(daysLeft, 1)),
                updatesDurationDays: nil,
                isLifetime: false,
                effectiveExpiresAt: today.addingTimeInterval(Double(daysLeft) * 86_400),
                effectiveUpdatesUntil: nil,
                denylistSequence: nil))
        }

        switch self {
        case .freemiumFree, .freemiumProNotActive:
            return .free
        case .freemiumFreeKeyActive, .freemiumProUpdates, .licensedUpdates:
            return updatesKey(untilDays: Self.simulatedUpdatesDays)
        case .freemiumProUpdatesExpireSoon, .licensedUpdatesExpireSoon:
            return updatesKey(untilDays: Self.simulatedExpireSoonDays)
        case .freemiumProLifetime, .fullAccess:
            return lifetimeKey()
        case .freemiumProUpdatesLapsed, .renewalRequired:
            return .renewalRequired(until: today.addingTimeInterval(-86_400))
        case .freemiumProTrial, .licensedTrialKey:
            return expiringKey(daysLeft: Self.simulatedTrialKeyDays)
        case .freemiumProTrialLastDay:
            return expiringKey(daysLeft: 0)
        case .freemiumProTrialExpired, .trialKeyExpired:
            return .invalid(.expired(on: today.addingTimeInterval(-86_400)))
        case .trial:
            return .trial(
                daysRemaining: Self.simulatedTrialDays,
                expiresOn: today.addingTimeInterval(Double(Self.simulatedTrialDays) * 86_400))
        case .trialEndingToday:
            return .trial(daysRemaining: 0, expiresOn: today)
        case .trialExpired:
            return .trialExpired(on: today.addingTimeInterval(-86_400))
        case .unlicensed:
            return .unlicensed
        case .invalidLicense:
            return .invalid(.badSignature)
        case .keyRevoked:
            return .invalid(.revoked(note: "refunded"))
        case .storageFailure:
            return .storageFailure
        case .real:
            return nil
        }
    }
}

/// Installs a native development menu without requiring changes to the host
/// app's SwiftUI `commands`. AppKit is used deliberately so this works for
/// SwiftUI, AppKit, and mixed macOS applications alike.
@MainActor
final class IndieLicenseDevelopmentMenu: NSObject {
    static let shared = IndieLicenseDevelopmentMenu()

    private static let topLevelTag = 0x494C_1000
    private static let scenarioTagBase = 0x494C_1100

    private weak var manager: LicenseManager?
    private var lifecycleObservers: [NSObjectProtocol] = []
    private var installationTask: Task<Void, Never>?

    private override init() {}

    func install(for manager: LicenseManager) {
        self.manager = manager
        if lifecycleObservers.isEmpty {
            for name in [
                NSApplication.didFinishLaunchingNotification,
                NSApplication.didBecomeActiveNotification,
            ] {
                lifecycleObservers.append(NotificationCenter.default.addObserver(
                    forName: name,
                    object: nil,
                    queue: .main
                ) { _ in
                    Task { @MainActor in
                        IndieLicenseDevelopmentMenu.shared.scheduleInstallation()
                    }
                })
            }
        }
        scheduleInstallation()
    }

    func updateSelection() {
        _ = installOrUpdateMenu()
    }

    private func scheduleInstallation() {
        installationTask?.cancel()
        installationTask = Task { @MainActor [weak self] in
            let clock = ContinuousClock()
            let delays: [Duration] = [.zero, .milliseconds(50), .milliseconds(250), .seconds(1)]
            for delay in delays {
                if delay != .zero {
                    do { try await clock.sleep(for: delay) }
                    catch { return }
                }
                guard !Task.isCancelled else { return }
                _ = self?.installOrUpdateMenu()
            }
        }
    }

    @discardableResult
    private func installOrUpdateMenu() -> Bool {
        guard let app = NSApp, let mainMenu = app.mainMenu, let manager else { return false }

        let menu: NSMenu
        if let existing = mainMenu.items.first(where: { $0.tag == Self.topLevelTag }),
           let existingMenu = existing.submenu {
            menu = existingMenu
            menu.removeAllItems()
        } else {
            let topLevelItem = NSMenuItem()
            topLevelItem.tag = Self.topLevelTag
            topLevelItem.title = "IndieLicense Testing"
            menu = NSMenu(title: topLevelItem.title)
            topLevelItem.submenu = menu
            mainMenu.addItem(topLevelItem)
        }

        for (index, scenario) in IndieLicenseDevelopmentScenario.relevantCases.enumerated() {
            if scenario == .invalidLicense || scenario == .real { menu.addItem(.separator()) }
            let item = NSMenuItem(
                title: scenario.title,
                action: #selector(selectScenario(_:)),
                keyEquivalent: "")
            item.target = self
            item.tag = Self.scenarioTagBase + index
            item.representedObject = scenario.rawValue
            item.state = manager.developmentScenario == scenario ? .on : .off
            menu.addItem(item)
        }
        return true
    }

    @objc private func selectScenario(_ sender: NSMenuItem) {
        guard let rawValue = sender.representedObject as? String,
              let scenario = IndieLicenseDevelopmentScenario(rawValue: rawValue) else { return }
        manager?.setDevelopmentScenario(scenario)
    }
}

private func indieLicenseDevelopmentUnixDay(of date: Date) -> Int {
    Int(floor(date.timeIntervalSince1970 / 86_400))
}

private func indieLicenseDevelopmentDate(ofUnixDay day: Int) -> Date {
    Date(timeIntervalSince1970: Double(day) * 86_400)
}
#endif
